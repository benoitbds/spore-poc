# Anthropic API Key (required for fallback, optional if using DeepSeek exclusively)
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# DeepSeek API Key (optional, for cost-optimized runs)
# DeepSeek pricing: $0.28/$0.42 per M tokens (vs Sonnet $3/$15)
# Get key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxx

# Optional: Semantic Scholar API Key (increases rate limit from 100/5min to 1000/5min)
SEMANTIC_SCHOLAR_API_KEY=

# Database path (default: ./data/spore.db)
SPORE_DB_PATH=./data/spore.db

# Output directory for generated hypotheses
SPORE_OUTPUT_DIR=./outputs

# Genome file path
SPORE_GENOME_PATH=./data/l0_genome.yaml

# Constitution file path (immutable rules)
SPORE_CONSTITUTION_PATH=./data/constitution.yaml

# Logging level (DEBUG, INFO, WARNING, ERROR)
SPORE_LOG_LEVEL=INFO

# Max budget per run in USD (safety limit)
SPORE_MAX_BUDGET_USD=20.0

# Email settings for autopilot digest
SPORE_SMTP_HOST=smtp.gmail.com
SPORE_SMTP_PORT=587
SPORE_SMTP_USER=
SPORE_SMTP_PASSWORD=
SPORE_DIGEST_RECIPIENTS=
