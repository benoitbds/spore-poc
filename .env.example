# Anthropic API Key (required for fallback, optional if using DeepSeek exclusively)
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# DeepSeek API Key (optional, for cost-optimized runs)
# DeepSeek pricing: $0.28/$0.42 per M tokens (vs Sonnet $3/$15)
# Get key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxx

# Optional: Semantic Scholar API Key (increases rate limit from 100/5min to 1000/5min)
SEMANTIC_SCHOLAR_API_KEY=

# Database path (default: ./data/spore.db)
SPORE_DB_PATH=./data/spore.db

# Output directory for generated hypotheses
SPORE_OUTPUT_DIR=./outputs

# Genome file path
SPORE_GENOME_PATH=./data/l0_genome.yaml

# Constitution file path (immutable rules)
SPORE_CONSTITUTION_PATH=./data/constitution.yaml

# Logging level (DEBUG, INFO, WARNING, ERROR)
SPORE_LOG_LEVEL=INFO

# Max budget per run in USD (safety limit)
SPORE_MAX_BUDGET_USD=20.0

# Email settings for autopilot digest + scripts/notify.py cron summaries.
# SMTP transport is shared; notify.py uses SPORE_NOTIFY_FROM/TO for routing
# (separate from the digest's SPORE_DIGEST_RECIPIENTS).
SPORE_SMTP_HOST=smtp.gmail.com
SPORE_SMTP_PORT=587
SPORE_SMTP_USER=
SPORE_SMTP_PASSWORD=
SPORE_DIGEST_RECIPIENTS=

# scripts/notify.py: one-screen email after each L0/L1 cron run.
# FROM is the authenticated sender (usually same as SMTP_USER). TO defaults
# to FROM if unset. Use a Gmail app password for SMTP_PASSWORD.
SPORE_NOTIFY_FROM=
SPORE_NOTIFY_TO=

# ── Monetisation API (api/ module) ───────────────────────────────
# These are *required* — api.config fails hard at import time if any
# are missing or under the minimum length.
#
# Stripe: create at https://dashboard.stripe.com/apikeys (sk_test_ for
# dev) and https://dashboard.stripe.com/webhooks (whsec_ signing secret).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend: create at https://resend.com/api-keys. Set up the sending
# domain (spore-research.com) first so FROM_EMAIL is deliverable.
RESEND_API_KEY=re_...

# JWT signing key for user sessions. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 chars. Never commit the real value.
JWT_SECRET=

# Public URLs used in magic-link / brief emails and Stripe redirects.
BASE_URL=https://spore-research.com
API_URL=https://api.spore-research.com

# Optional: override the From header (must be authorised in Resend).
# FROM_EMAIL=SPORE <noreply@spore-research.com>
